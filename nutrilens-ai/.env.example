# ============================================================
# NutriLens AI — Production Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to source control.

# ──────────────────────────────────────────────
# Backend (FastAPI)
# ──────────────────────────────────────────────

# SQLite (default) or swap in PostgreSQL for scaled deployments.
# PostgreSQL example: postgresql://user:password@db:5432/nutrilens
DATABASE_URL=sqlite:///./nutrilens.db

# REQUIRED: generate a strong secret ≥ 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# "development" | "production"
ENVIRONMENT=production

# Paths to trained ML model files (inside container)
FRESHNESS_MODEL_PATH=./ml_models/freshness_model.h5
FOOD_RECOGNITION_MODEL_PATH=./ml_models/food_recognition_model.h5
WASTE_MODEL_PATH=./ml_models/waste_model.h5
MILK_QUALITY_MODEL_PATH=./ml_models/milk_quality_model.pkl

# ──────────────────────────────────────────────
# Frontend (Next.js)
# ──────────────────────────────────────────────

# When running in Docker, the frontend calls the backend via the
# internal network alias. Change to your public API domain in the cloud.
NEXT_PUBLIC_API_URL=http://backend:8000
